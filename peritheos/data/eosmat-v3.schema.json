{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peritheos.readthedocs.io/schemas/eosmat-v3.schema.json",
  "title": "Peritheos material (.eosmat) format 3",
  "description": "A material with optional crystallographic data and zero or more literature EOS records. Its storage shape is an additive evolution of Dioptas 0.10.0 format 2; consumers must still recognize every selected equation option before numerical evaluation.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "identifier",
    "name",
    "formula",
    "units",
    "eos_records"
  ],
  "properties": {
    "format": {
      "enum": ["peritheos.material"],
      "description": "Canonical format discriminator."
    },
    "format_version": {
      "const": 3
    },
    "identifier": {
      "$ref": "#/$defs/identifier",
      "description": "Stable lower-snake-case material identifier."
    },
    "name": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "cell_contents": {
      "type": "string",
      "description": "Human-readable definition of the conventional cell used by all record volumes."
    },
    "units": {
      "type": "object",
      "required": ["pressure", "temperature", "volume"],
      "properties": {
        "pressure": {"const": "GPa"},
        "temperature": {"const": "K"},
        "volume": {"const": "angstrom^3/conventional_unit_cell"}
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string"}
    },
    "symmetry": {
      "type": "string"
    },
    "lattice": {
      "$ref": "#/$defs/lattice"
    },
    "formula_units_per_cell": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "Crystallographic Z used to convert conventional-cell volume to formula-molar volume."
    },
    "space_group": {
      "type": "string"
    },
    "space_group_number": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 230
    },
    "atom_sites": {
      "type": "array",
      "items": {"$ref": "#/$defs/atom_site"}
    },
    "source": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    },
    "peaks": {
      "type": "array",
      "items": {"$ref": "#/$defs/peak"}
    },
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"},
      "description": "Primary experimental datasets used to derive one or more EOS records. Small tables may be embedded as rows; larger tables may use a checksummed relative resource."
    },
    "eos_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/eos_record"},
      "description": "Literature EOS parameterizations for this material and phase; may be empty for a structure-only exchange document."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "nullable_number": {
      "type": ["number", "null"]
    },
    "lattice": {
      "type": "object",
      "required": ["a", "b", "c", "alpha", "beta", "gamma"],
      "properties": {
        "a": {"type": "number"},
        "b": {"$ref": "#/$defs/nullable_number"},
        "c": {"$ref": "#/$defs/nullable_number"},
        "alpha": {"type": "number"},
        "beta": {"type": "number"},
        "gamma": {"type": "number"}
      },
      "additionalProperties": false
    },
    "atom_site": {
      "type": "object",
      "required": ["element", "x", "y", "z", "occupancy"],
      "properties": {
        "element": {"type": "string"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"},
        "occupancy": {"type": "number"},
        "wyckoff": {"type": "string"}
      },
      "additionalProperties": true
    },
    "peak": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "dataset_column": {
      "type": "object",
      "required": ["name", "quantity", "unit", "role"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "role": {"enum": ["value", "standard_deviation", "standard_error", "bound", "flag"]},
        "of": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": true
    },
    "dataset_resource": {
      "type": "object",
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "required": ["identifier", "kind", "reference", "source_location", "columns", "used_by_eos_records"],
      "properties": {
        "identifier": {"$ref": "#/$defs/identifier"},
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "reference": {"$ref": "#/$defs/reference"},
        "source_location": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "license": {"type": "string"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dataset_column"}
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": ["number", "null"]}
          }
        },
        "resource": {"$ref": "#/$defs/dataset_resource"},
        "used_by_eos_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "uncertainty": {"type": "object"},
        "notes": {"type": "string"}
      },
      "oneOf": [
        {"required": ["rows"]},
        {"required": ["resource"]}
      ],
      "additionalProperties": true
    },
    "reference": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["authors", "year", "source"],
          "properties": {
            "authors": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            },
            "authors_truncated": {"type": "boolean"},
            "year": {"type": "integer"},
            "title": {"type": "string"},
            "source": {"type": "string"},
            "volume": {"type": "string"},
            "locator": {"type": "string"},
            "details": {"type": "string"},
            "doi": {"type": "string"}
          },
          "additionalProperties": true
        }
      ]
    },
    "equation": {
      "type": "object",
      "required": ["type", "model", "parameters"],
      "properties": {
        "type": {
          "enum": [
            "BM2",
            "BM3",
            "BM4",
            "Holzapfel",
            "ModifiedTait",
            "Murnaghan",
            "NaturalStrain2",
            "NaturalStrain3",
            "NaturalStrain4",
            "Vinet"
          ]
        },
        "model": {
          "enum": [
            "birch_murnaghan_2",
            "birch_murnaghan_3",
            "birch_murnaghan_4",
            "holzapfel",
            "modified_tait",
            "murnaghan",
            "natural_strain_2",
            "natural_strain_3",
            "natural_strain_4",
            "vinet"
          ]
        },
        "parameters": {
          "type": "object",
          "required": ["V0"],
          "additionalProperties": {"type": "number"}
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "oneOf": [
            {"properties": {"type": {"const": "BM2"}, "model": {"const": "birch_murnaghan_2"}}},
            {"properties": {"type": {"const": "BM3"}, "model": {"const": "birch_murnaghan_3"}}},
            {"properties": {"type": {"const": "BM4"}, "model": {"const": "birch_murnaghan_4"}}},
            {"properties": {"type": {"const": "Holzapfel"}, "model": {"const": "holzapfel"}}},
            {"properties": {"type": {"const": "ModifiedTait"}, "model": {"const": "modified_tait"}}},
            {"properties": {"type": {"const": "Murnaghan"}, "model": {"const": "murnaghan"}}},
            {"properties": {"type": {"const": "NaturalStrain2"}, "model": {"const": "natural_strain_2"}}},
            {"properties": {"type": {"const": "NaturalStrain3"}, "model": {"const": "natural_strain_3"}}},
            {"properties": {"type": {"const": "NaturalStrain4"}, "model": {"const": "natural_strain_4"}}},
            {"properties": {"type": {"const": "Vinet"}, "model": {"const": "vinet"}}}
          ]
        }
      ]
    },
    "thermal": {
      "type": "object",
      "required": ["type", "model", "parameters"],
      "properties": {
        "type": {
          "enum": [
            "AlphaKT",
            "AsymptoticPowerLawMieGruneisenDebye",
            "DoubleDebyeHelmholtz",
            "DoubleDebyeLogMomentHelmholtz",
            "DorogokupetsOganov2007",
            "LinearThermalPressure",
            "LogVolumeThermalPressure",
            "MieGruneisenDebye",
            "MieGruneisenEinstein",
            "MultiOscillatorGruneisen",
            "Sokolova2016",
            "ThermalModifiedTait"
          ]
        },
        "model": {
          "enum": [
            "thermal_reference_state",
            "asymptotic_power_law_mie_gruneisen_debye",
            "double_debye_helmholtz",
            "double_debye_log_moment_helmholtz",
            "dorogokupets_oganov_2007",
            "linear_thermal_pressure",
            "log_volume_thermal_pressure",
            "mie_gruneisen_debye",
            "mie_gruneisen_einstein",
            "multi_oscillator_gruneisen_thermal_pressure",
            "thermal_modified_tait"
          ]
        },
        "debye_temperature_law": {
          "enum": ["integrated_gruneisen", "variable_exponent"],
          "default": "integrated_gruneisen",
          "description": "Characteristic-temperature relation for MieGruneisenDebye. Omission means integrated_gruneisen; JSON Schema defaults are annotations and do not insert the field."
        },
        "thermal_expansion_law": {
          "enum": ["constant", "linear_temperature"],
          "default": "constant",
          "description": "Volumetric expansion law integrated by thermal_reference_state. Omission means constant; linear_temperature requires alpha1."
        },
        "reference_volume_law": {
          "enum": ["integrated_expansivity", "linear_temperature", "berman"],
          "default": "integrated_expansivity",
          "description": "Reference-volume construction for thermal_reference_state. Omission integrates the selected expansivity; linear_temperature applies V0(T)=V0(Tr)*(1+alpha0*(T-Tr)); berman applies V0(T)=V0(Tr)*(1+alpha0*(T-Tr)+0.5*alpha1*(T-Tr)^2)."
        },
        "parameters": {
          "type": "object",
          "properties": {
            "Tr": {
              "anyOf": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "null"}
              ],
              "description": "Reference-isotherm temperature in K. For absolute Helmholtz cold-curve models, null means that no reference subtraction is applied."
            }
          },
          "additionalProperties": {"type": "number"}
        },
        "parameter_errors": {
          "$ref": "#/$defs/parameter_errors"
        },
        "fixed_parameters": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "oneOf": [
            {"properties": {"type": {"const": "AlphaKT"}, "model": {"const": "thermal_reference_state"}}},
            {"properties": {"type": {"const": "AsymptoticPowerLawMieGruneisenDebye"}, "model": {"const": "asymptotic_power_law_mie_gruneisen_debye"}}},
            {"properties": {"type": {"const": "DoubleDebyeHelmholtz"}, "model": {"const": "double_debye_helmholtz"}}},
            {"properties": {"type": {"const": "DoubleDebyeLogMomentHelmholtz"}, "model": {"const": "double_debye_log_moment_helmholtz"}}},
            {"properties": {"type": {"const": "DorogokupetsOganov2007"}, "model": {"const": "dorogokupets_oganov_2007"}}},
            {"properties": {"type": {"const": "LinearThermalPressure"}, "model": {"const": "linear_thermal_pressure"}}},
            {"properties": {"type": {"const": "LogVolumeThermalPressure"}, "model": {"const": "log_volume_thermal_pressure"}}},
            {"properties": {"type": {"const": "MieGruneisenDebye"}, "model": {"const": "mie_gruneisen_debye"}}},
            {"properties": {"type": {"const": "MieGruneisenEinstein"}, "model": {"const": "mie_gruneisen_einstein"}}},
            {"properties": {"type": {"const": "MultiOscillatorGruneisen"}, "model": {"const": "multi_oscillator_gruneisen_thermal_pressure"}}},
            {"properties": {"type": {"const": "Sokolova2016"}, "model": {"const": "multi_oscillator_gruneisen_thermal_pressure"}}},
            {"properties": {"type": {"const": "ThermalModifiedTait"}, "model": {"const": "thermal_modified_tait"}}}
          ]
        },
        {
          "if": {"required": ["debye_temperature_law"]},
          "then": {"properties": {"type": {"const": "MieGruneisenDebye"}}}
        },
        {
          "if": {"required": ["thermal_expansion_law"]},
          "then": {"properties": {"type": {"const": "AlphaKT"}}}
        },
        {
          "if": {"required": ["reference_volume_law"]},
          "then": {"properties": {"type": {"const": "AlphaKT"}}}
        },
        {
          "if": {"properties": {"thermal_expansion_law": {"const": "linear_temperature"}}, "required": ["thermal_expansion_law"]},
          "then": {"properties": {"parameters": {"required": ["alpha1"]}}}
        },
        {
          "if": {
            "anyOf": [
              {"not": {"required": ["thermal_expansion_law"]}},
              {"properties": {"thermal_expansion_law": {"const": "constant"}}, "required": ["thermal_expansion_law"]}
            ]
          },
          "then": {"properties": {"parameters": {"properties": {"alpha1": {"const": 0}}}}}
        },
        {
          "if": {
            "properties": {"reference_volume_law": {"const": "linear_temperature"}},
            "required": ["reference_volume_law"]
          },
          "then": {
            "properties": {
              "thermal_expansion_law": {"const": "constant"},
              "parameters": {"properties": {"alpha1": {"const": 0}}}
            }
          }
        },
        {
          "if": {
            "properties": {"reference_volume_law": {"const": "berman"}},
            "required": ["reference_volume_law"]
          },
          "then": {
            "properties": {
              "thermal_expansion_law": {"const": "linear_temperature"},
              "parameters": {"required": ["alpha1"]}
            }
          }
        }
      ]
    },
    "parameter_errors": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/nullable_number"}
    },
    "range": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "validity": {
      "type": "object",
      "properties": {
        "pressure_gpa": {"$ref": "#/$defs/range"},
        "temperature_k": {"$ref": "#/$defs/range"},
        "volume_ratio": {"$ref": "#/$defs/range"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "volume_metadata": {
      "type": "object",
      "properties": {
        "reference_value": {"type": "number", "exclusiveMinimum": 0},
        "public_to_model_scale": {"type": "number", "exclusiveMinimum": 0},
        "model_unit": {"type": "string"}
      },
      "additionalProperties": false
    },
    "parameter_covariance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["matrix", "parameter_order"],
          "properties": {
            "matrix": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "number"}
              }
            },
            "parameter_order": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fit_provenance": {
      "type": "object",
      "required": [
        "software",
        "dataset",
        "selection",
        "objective",
        "refined_parameters",
        "fixed_parameters",
        "statistics"
      ],
      "properties": {
        "software": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "version_date": {"type": "string", "format": "date"}
          },
          "additionalProperties": true
        },
        "dataset": {"$ref": "#/$defs/identifier"},
        "selection": {"type": "object"},
        "objective": {"type": "string", "minLength": 1},
        "weights": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        "refined_parameters": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "fixed_parameters": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "covariance_scaling": {"type": "string"},
        "statistics": {"type": "object"},
        "reproduction": {"type": "object"}
      },
      "additionalProperties": true
    },
    "scientific_validation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["primary_source_validated", "pending_primary_source_check", "deferred"]
        },
        "note": {"type": "string"},
        "migration_source": {"type": "object"}
      },
      "additionalProperties": true
    },
    "pressure_calibration_method": {
      "type": "object",
      "required": ["kind", "source_location"],
      "properties": {
        "kind": {
          "enum": [
            "equation_of_state",
            "ruby_fluorescence",
            "other_optical_gauge",
            "shock_wave",
            "ultrasonic",
            "ab_initio",
            "self_consistent",
            "ambient_pressure",
            "other"
          ]
        },
        "reference_eos_record": {
          "$ref": "#/$defs/identifier",
          "description": "Globally unique identifier of the exact reference EOS when that executable record is bundled in the Peritheos material library."
        },
        "reference_calibration_record": {
          "$ref": "#/$defs/identifier",
          "description": "Globally unique identifier of an executable non-EOS pressure calibration, such as a ruby R1 scale, bundled in the Peritheos calibration library."
        },
        "reference": {"$ref": "#/$defs/reference"},
        "source_location": {"type": "string", "minLength": 1},
        "scope": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "equation_of_state"}},
            "required": ["kind"]
          },
          "then": {"required": ["reference"]}
        }
      ]
    },
    "pressure_calibration": {
      "type": "object",
      "required": ["status", "methods", "recalculation"],
      "properties": {
        "status": {
          "enum": ["resolved", "partially_resolved", "not_applicable", "unresolved"]
        },
        "methods": {
          "type": "array",
          "items": {"$ref": "#/$defs/pressure_calibration_method"}
        },
        "recalculation": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "enum": [
                "ready",
                "missing_calibrant_observations",
                "reference_eos_not_bundled",
                "reference_model_not_supported",
                "not_applicable",
                "not_possible"
              ]
            },
            "notes": {"type": "string"}
          },
          "additionalProperties": true
        },
        "audit_date": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "eos_record": {
      "type": "object",
      "required": [
        "label",
        "identifier",
        "reference",
        "eos",
        "parameter_errors",
        "fixed_parameters",
        "scientific_validation"
      ],
      "properties": {
        "identifier": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string"},
        "reference": {"$ref": "#/$defs/reference"},
        "default": {"type": "boolean"},
        "record_kind": {
          "enum": ["published", "refit", "diagnostic"],
          "description": "Scientific status of the parameter set. Omission means published for backward compatibility."
        },
        "derived_from_record": {
          "$ref": "#/$defs/identifier",
          "description": "EOS record whose equation choices or published fixed parameters form the basis of this derived record."
        },
        "fit_provenance": {"$ref": "#/$defs/fit_provenance"},
        "eos": {"$ref": "#/$defs/equation"},
        "parameter_errors": {"$ref": "#/$defs/parameter_errors"},
        "parameter_error_confidence": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Two-sided confidence level of reported parameter-error half-widths. Null means the values are standard errors or the source convention is otherwise recorded in notes."
        },
        "fixed_parameters": {
          "type": "array",
          "items": {"type": "string"}
        },
        "experimental_pressure_range_gpa": {"$ref": "#/$defs/range"},
        "pressure_range_status": {
          "enum": ["reported_exactly", "reported_qualitatively", "theoretical", "reference_parameterization"]
        },
        "experimental_temperature_range_k": {"$ref": "#/$defs/range"},
        "thermal": {"$ref": "#/$defs/thermal"},
        "temperature_ref": {"type": "number"},
        "volume": {"$ref": "#/$defs/volume_metadata"},
        "validity": {"$ref": "#/$defs/validity"},
        "parameter_provenance": {"type": "object"},
        "source_lineage": {
          "type": "array",
          "description": "Ordered scientific-fit, parameter-table, implementation, correction, and experimental-context sources contributing to a composite record.",
          "items": {
            "type": "object",
            "required": ["role", "citation"],
            "properties": {
              "role": {"type": "string"},
              "citation": {"type": "string"},
              "doi": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "pressure_calibration": {"$ref": "#/$defs/pressure_calibration"},
        "parameter_covariance": {"$ref": "#/$defs/parameter_covariance"},
        "scientific_validation": {"$ref": "#/$defs/scientific_validation"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"record_kind": {"const": "refit"}},
            "required": ["record_kind"]
          },
          "then": {"required": ["derived_from_record", "fit_provenance"]}
        }
      ],
      "additionalProperties": true
    }
  }
}
