       ],
       "year": 2003,
       "source": "J. Geophys. Res. Solid Earth",
       "volume": "108",
       "locator": "2462",
       "doi": "10.1029/2003JB002446"
      },
      "source_location": "Experimental procedures, paragraphs 7-8; Results, paragraph 12",
      "scope": "pressures calculated from simultaneous Au volume and measured temperature"
     }
    ],
    "recalculation": {
