   "parameter_provenance": {
    "V0": "Results, page 1628: the simulations predict V0=287.49 A^3 at P=0",
    "K0": "Abstract and Table 2, pages 1627 and 1629: KT(0)=99.0(5) GPa for this work's unconstrained third-order fit",
