      "experimental_configuration": {
        "apparatus": "laser-heated Mao-Bell diamond-anvil cell",
        "laser_heating": "2000-3000 K for about 60 minutes",
        "measurement_temperature": "room temperature after heating; no numerical value reported",
        "diffraction": "laboratory XRD and TEM for recovered run 3; synchrotron XRD at SSRL beamline 10-2 for run 4",
