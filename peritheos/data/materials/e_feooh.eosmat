        "volume_ratio": [0.93832, 1.0],
        "notes": [
          "The authors note a possible change in compression slope at 3-7 GPa (possibly deviatoric stress or hydrogen-bond symmetrization); the fit is one smooth curve."
        ]
      },
      "experimental_pressure_range_gpa": [0.0001, 11.07],
