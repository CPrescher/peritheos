      },
      "experimental_pressure_range_gpa": [3.81, 21.01],
      "experimental_temperature_range_k": [473.15, 673.15],
      "pressure_range_status": "reported_exactly",
      "determination_method": "experimental",
      "record_kind": "published",
      "notes": "300 K BM2 reference curve from a pooled fit to 49 elevated-temperature observations, with K0' = 4 assumed and V0 from a separate G-versus-g extrapolation. It is not a temperature-dependent EOS: hot states require the documented fit-time volume reduction and must not be evaluated as 300 K observations; the paper prints no correction equation. Phase: InOOH-type with off-center hydrogen, P21mn setting in the source (P21nm here).",
      "fit_datasets": ["epsilon_feooh_gleason_2008_deposit_table2_pvt"],
      "reference": {
