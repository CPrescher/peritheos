        "K0": {"value": 135.0, "error": 3.0},
        "K0_prime": {"value": 6.1, "error": 0.9}
      },
      "thermal": {
        "model": "AlphaKT",
        "parameters": {
          "Tr": {"value": 300.0, "error": null, "fixed": true},
          "alpha0": {"value": 2.6e-05, "error": 7e-06},
          "alpha1": {"value": 1e-07, "error": 3e-08},
          "dK_dT": {"value": -0.05, "error": 0.02}
        },
        "thermal_expansion_law": "linear_reference_temperature",
        "reference_volume_law": "integrated_expansivity"
      },
