     "source_locations": [
      "Delta_v3-1_0.zip/history.tar.gz/history/exp.txt",
      "Lejaeghere et al. (2014) Supplementary Tables 2.2-2.4"
     ],
     "finding": "The archive supplies only a constructed coefficient table. Exact pre-correction inputs, a unified P-V dataset, pressure calibration, uncertainties, weights, and selection rules are not available, so an independent fit of the composite triplet is impossible. Property-level upstream recovery is recorded separately and includes row-level data only where the cited source actually prints it."
    },
    "upstream_data_recovery": {
     "audit_date": "2026-09-07",
     "manifest": "datasets/deltaproject-experimental-reference-source.json",
     "V0": {
      "status": "upstream_table_identified",
      "finding": "Villars and Daams (1993) is a crystallographic structure/volume compilation, not a pressure-volume experiment. Supplementary Table 2.2 preserves the rounded ambient volumes and the applied thermal and zero-point shifts; no per-element raw compression observations exist in this branch."
     },
     "K0": {
      "status": "secondary_table_recovered",
      "finding": "Kittel Table 3 is the immediate source for 40 selected metals. The table itself identifies Gschneidner (1964), DOI 10.1016/S0081-1947(08)60518-4, as its principal compilation and Birch (1966) as an additional source, and explicitly advises consulting original references for research use. This branch is therefore not raw data."
     },
     "K0_prime": {
      "status": "30_of_32_values_reconstructed",
      "dataset": "datasets/deltaproject-knittle-1995-b0prime-reconstruction.csv",
      "finding": "Knittle Table 1 directly supplies, or supplies the entries whose arithmetic mean gives, 30 of the 32 default Delta B0-prime values. Fe=4.6 and Au=6.4 cannot be reproduced by a documented selection or simple mean of the listed rows. The reconstruction retains Knittle's reference numbers and phase warnings.",
      "element_reconstruction": {
