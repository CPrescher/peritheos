   "experimental_pressure_range_gpa": [
    0.0,
    550.0
   ],
   "notes": "The 300 K pressure scale is Holmes et al.'s theoretical universal (Vinet) EOS, qualified against shock data to at least 10% in pressure: V0=101.9 bohr^3/atom (converted to the four-atom fcc cell), K0=266 GPa, and K0'=5.81. Their approximate finite-temperature extension adds alpha*K_T*(T-300 K), with alpha=0.261e-4 K^-1 and K_T=266 GPa, and is stated to be adequate below 2000 K. The 300 K isotherm itself is represented through 550 GPa; 32-660 GPa is the shock-Hugoniot range, not the static-isotherm validity range.",
   "thermal": {
    "type": "LinearThermalPressure",
    "model": "linear_thermal_pressure",
    "parameters": {
     "Tr": 300.0,
     "alpha_KT": 0.0069426
    },
    "parameter_errors": {
     "Tr": null,
     "alpha_KT": null
    },
    "fixed_parameters": []
   },
