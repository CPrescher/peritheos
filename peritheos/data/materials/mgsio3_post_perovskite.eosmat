      },
      "model": "BM3",
      "temperature_ref": 300.0,
      "parameters": {
        "V0": {"value": 158.0, "error": 1.5},
        "K0": {"value": 292.0, "error": 22.0},
        "K0_prime": {"value": 3.74, "error": 0.13}
      },
      "experimental_pressure_range_gpa": [100.0, 265.0],
      "determination_method": "experimental",
      "notes": "Experimental BM3 fit 1 to laser-heated DAC data from this study plus Guignot et al., reaching 265 GPa. Stored as a room-temperature cold curve only because the published thermal fit uses an Al'tshuler gamma(V) function not implemented by Dioptas. Sakai et al. prefer their Keane fit for multi-megabar extrapolation; the BM3 parameters are strongly correlated and should be used within the experimental range rather than extrapolated.",
      "reference": {
        "authors": ["Sakai", "Dekura", "Hirao"],
        "year": 2016,
        "title": "Experimental and theoretical thermal equations of state of MgSiO3 post-perovskite at multi-megabar pressures",
        "source": "Scientific Reports",
        "volume": "6",
        "locator": "22652",
        "doi": "10.1038/srep22652"
      }
    },
    {
      "identifier": "mgsio3_post_perovskite_ono_2006_anderson_bm2_3",
      "label": "Ono et al. (2006), Anderson-gold-scale constrained BM3 (BM2)",
