    {
      "identifier": "mgsio3_post_perovskite_mosenfelder_2009_bm3_1",
      "label": "Mosenfelder et al. (2009), shock-static BM3-MGD",
      "check": {
        "reproduction": "reproduced",
        "compared": "published_fit",
        "warning": null,
        "source_check": "verified",
        "source_checked_on": "2026-09-01",
        "source_note": "The complete published BM3 reference-isentrope plus Debye thermal model is executable. The fitted Cvm is stored as molar Cvmax, and the shock reduction closes in pressure-density space without inventing missing temperatures.",
        "audit": "../audits/mgsio3_post_perovskite.audit.json#mgsio3_post_perovskite_mosenfelder_2009_bm3_1"
      },
      "model": "BM3",
      "temperature_ref": 300.0,
      "parameters": {
        "V0": {"value": 162.2, "error": null, "fixed": true},
        "K0": {"value": 225.0, "error": 2.0},
        "K0_prime": {"value": 4.21, "error": 0.07}
      },
      "thermal": {
        "model": "MieGruneisenDebye",
        "parameters": {
          "Tr": {"value": 300.0, "error": null, "fixed": true},
          "theta0": {"value": 990.0, "error": 146.0},
          "gamma0": {"value": 2.61, "error": 0.67},
          "q": {"value": 2.1, "error": 0.8},
          "n": {"value": 5, "error": null, "fixed": true},
          "Cvmax": {"value": 103.9010625, "error": 5.019375}
        },
        "thermal_pressure_reference": "reference_isentrope",
        "debye_temperature_law": "integrated_gruneisen"
      },
      "experimental_pressure_range_gpa": [111.0, 245.0],
      "experimental_temperature_range_k": [300.0, 2535.0],
      "determination_method": "experimental",
      "notes": "Global errors-in-variables inversion of 48 Guignot et al. static P-V-T observations and six PPv shock P-density states. V0=162.2 A^3 was fixed. Table 4 reports K0S=225(2) GPa, K0S'=4.21(7), theta0=990(146) K, gamma0=2.61(67), q=2.1(8), and Cvm=1.035(50) J g^-1 K^-1; Cvmax is the exact molar conversion using 100.3875 g mol^-1. The BM3 term is a 300 K reference isentrope, so thermal pressure subtracts energy at T_S(V)=Tr*theta(V)/theta0. The three source-reported shock temperatures are retained as measured diagnostics but are not constraints in the solid PPv inversion; section 3 explicitly identifies shock-temperature fitting only for MgSiO3 liquid.",
      "fit_datasets": ["mgsio3_post_perovskite_guignot_2007_table1_pvt", "mgsio3_post_perovskite_mosenfelder_2009_table2_shock"],
      "reference": {
        "authors": ["Mosenfelder", "Asimow", "Frost", "Rubie", "Ahrens"],
        "year": 2009,
        "title": "The MgSiO3 system at high pressure: Thermodynamic properties of perovskite, postperovskite, and melt from global inversion of shock and static compression data",
        "source": "Journal of Geophysical Research: Solid Earth",
        "volume": "114",
        "locator": "B01203",
        "doi": "10.1029/2008JB005900"
      }
    },
    {
      "identifier": "mgsio3_post_perovskite_sakai_2016_bm3_2",
      "label": "Sakai et al. (2016), experimental multi-megabar BM3",
      "check": {
