        "source_checked_on": "2026-09-05",
        "source_note": "The source defines a standard Eulerian BM3 at 300 K, fixes K0_prime=4 and V0=162.86 A^3, fits K0 separately on three named gold pressure scales, and prints every sample and calibrant lattice observation. The Anderson-scale fit is represented exactly by BM2.",
        "audit": "../audits/mgsio3_post_perovskite.audit.json#mgsio3_post_perovskite_ono_2006_anderson_bm2_3"
      },
      "model": "BM2",
      "temperature_ref": 300.0,
      "parameters": {
        "V0": {"value": 162.86, "error": null, "fixed": true},
        "K0": {"value": 237.0, "error": 1.0}
      },
      "parameter_error_confidence": null,
      "parameter_covariance": null,
      "validity": {
        "pressure_gpa": [116.1, 144.4],
        "temperature_k": [300.0, 300.0],
        "notes": [
          "The pressure interval is the marginal range of the six Anderson-et-al.-gold-scale observations, not an extrapolation range for the zero-pressure reference parameters.",
          "The source reports that the CaIrO3-type phase remained stable over its 116-144 GPa experimental range and was difficult to measure below 110 GPa because it is metastable there."
        ]
      },
      "experimental_pressure_range_gpa": [116.1, 144.4],
      "experimental_temperature_range_k": [300.0, 300.0],
      "pressure_range_status": "reported_exactly",
      "determination_method": "experimental",
      "record_kind": "published",
      "notes": "Pure MgSiO3 CaIrO3-type post-perovskite, not CaIrO3 composition or bridgmanite. The conventional Cmcm volume contains four MgSiO3 formula units. This pressure-scale-specific record is distinct from the later Mosenfelder and Sakai parameterizations.",
      "fit_datasets": ["mgsio3_post_perovskite_ono_2006_table2_compression"],
      "reference": {
        "authors": ["Ono", "Kikegawa", "Ohishi"],
        "year": 2006,
        "title": "Equation of state of CaIrO3-type MgSiO3 up to 144 GPa",
        "source": "American Mineralogist",
        "volume": "91",
        "locator": "475-478",
        "doi": "10.2138/am.2006.2118"
      },
      "equation_kind": "isothermal",
      "experimental_configuration": {
        "starting_material": "synthetic MgSiO3 enstatite ground to less than a few micrometers",
        "sample_phase": "CaIrO3-type MgSiO3 synthesized above 120 GPa by laser heating to about 1500-2500 K, then slowly returned to 300 K",
        "pressure_medium": "NaCl",
        "pressure_gauge": "gold powder mixed with the sample",
        "diffraction": "angle-dispersive synchrotron powder X-ray diffraction at Photon Factory BL13A and SPring-8 BL10XU",
        "annealing": "YAG-laser heated after each pressure change to reduce differential stress"
      }
    },
