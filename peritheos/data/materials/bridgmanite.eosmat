      "identifier": "bridgmanite_saxena_1999_bm3_4",
      "label": "Saxena et al. (1999), 300 K BM3 slice",
      "model": "BM3",
      "temperature_ref": 300.0,
      "parameters": {
        "V0": {"value": 162.4007, "error": null},
        "K0": {"value": 260.51, "error": null},
        "K0_prime": {"value": 4.0, "error": null, "fixed": true}
      },
      "parameter_error_confidence": null,
      "experimental_pressure_range_gpa": [0.0, 82.5],
      "experimental_temperature_range_k": [300.0, 300.0],
      "pressure_range_status": "reported_exactly",
      "validity": {
        "pressure_gpa": [0.0, 82.5],
        "temperature_k": [300.0, 300.0],
        "notes": [
          "The upper pressure bound is the highest 300 K observation in the authors' Table 1; the complete new P-V-T table extends to 109.1 GPa and 1485 K.",
          "The lower bound includes the published zero-pressure reference state. It is not a phase-stability boundary.",
          "Do not use this static slice as either of the source's high-temperature Model 1 or Model 2 curves."
        ]
      },
      "determination_method": "experimental",
      "notes": "Published 300 K isotherm of the two high-temperature Birch-Murnaghan models, which coincide at 300 K. The full Model 1 and Model 2 parameterizations are intentionally not represented: they require the article's quadratic temperature laws for thermal expansivity and compressibility together with its temperature-dependent K'_T convention, which the current Peritheos thermal reference-state model cannot encode exactly. The executable record is therefore restricted to 300 K and is not the default bridgmanite EOS. The natural-enstatite starting material contained less than 1% Al and Fe; the authors identify the transformed phase and reported volumes as MgSiO3 perovskite. No EOS-parameter errors, confidence convention, covariance, residual statistic, or fit weights are published.",
      "fit_datasets": ["bridgmanite_saxena_1999_table1_pvt"],
      "parameter_covariance": null,
      "reference": {
        "authors": ["Saxena", "Dubrovinsky", "Tutti", "Le Bihan"],
        "year": 1999,
        "title": "Equation of state of MgSiO3 with the perovskite structure based on experimental measurement",
        "source": "American Mineralogist",
