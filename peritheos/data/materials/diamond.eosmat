        "locations": ["Equations 2-7 and 13-18", "Table I, diamond row", "Figures 3 and 5-8", "Section II.A"]
      },
      "volume": {"reference_value": 46.28, "public_to_model_scale": 0.00752767595, "model_unit": "J bar^-1 mol^-1"}
    },
