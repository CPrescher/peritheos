        "K0": {"value": 368.2, "error": null},
        "K0_prime": {"value": 4.038, "error": null}
      },
      "thermal": {
        "model": "DoubleDebyeLogMomentHelmholtz",
        "parameters": {
          "Vp": {"value": 0.3354934617396, "error": null},
          "theta_a0": {"value": 1887.8, "error": null},
          "a_a": {"value": -5.247303452269356, "error": null},
          "b_a": {"value": 0.913, "error": null},
          "theta_b0": {"value": 1887.8, "error": null},
          "a_b": {"value": 2.7897056328520624, "error": null},
          "b_b": {"value": 0.429, "error": null},
          "theta_0_0": {"value": 1887.8, "error": null},
          "a_0": {"value": 2.175306177997739, "error": null},
          "b_0": {"value": 0.202, "error": null},
          "n": {"value": 1.0, "error": null},
          "anharmonic_a": {"value": 3.8e-05, "error": null},
          "phi0": {"value": -14960919.113708327, "error": null},
          "Tr": {"value": null, "error": null}
        },
        "notes": "Follows Correa Equation 18 literally: F_anh = -a*T^2 with a = 3.8e-5 K^-1, which adds no pressure. Benedict (2014) writes -alpha*T^2/2 with alpha = 3.79e-5 K^-1, so the equivalent alpha is 2*a. Electronic excitations are neglected."
      },
      "validity": {
        "pressure_gpa": [0.0, 1075.0],
        "temperature_k": [1.0, 10000.0],
        "volume_ratio": [0.40103716508210885, 1.0],
        "notes": [
          "The lower volume bound is the compressed phonon-DOS state of Figure 3. The cold curve was fitted over about 1-9 Å³/atom.",
          "The upper pressure is the calculated 0 K diamond-BC8 crossing, not a finite-temperature phase boundary."
        ]
      },
      "determination_method": "theoretical",
      "notes": "Complete diamond free-energy model of Equations 2-18, with a motionless-ion DFT-GGA Vinet cold curve. The authors state that its V0 is about 3% too large after zero-point and thermal effects and may need an application-specific density shift. Published volumes are per atom; stored per eight-atom conventional cell.",
      "reference": {
        "authors": ["Correa", "Benedict", "Young", "Schwegler", "Bonev"],
        "year": 2008,
        "title": "First-principles multiphase equation of state of carbon under extreme conditions",
        "source": "Phys. Rev. B",
        "volume": "78",
        "locator": "024101",
