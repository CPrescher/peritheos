        "recalculation": {
          "status": "not_applicable",
          "notes": "This is a jointly optimized pressure-scale model rather than a fit reduced with one external reference EOS."
        },
        "audit_date": "2026-09-03"
      },
      "evidence": {
        "reproduction": {
          "assessment": {
            "status": "source_reconstruction",
            "scope": "source_equation",
            "source_status": "source_reconstruction",
            "basis": "All eleven machine-readable comparison series enter one shared Equation (20) objective against the mean Table 2 Holzapfel and Table 3 Vinet isotherm. Table 4 is retained as a post-calibration closure test. The calculation cannot recover the eleven EOS parameter sets independently because the source omits complete thermochemical/ultrasonic rows, weights, and covariance.",
