    {
      "identifier": "feo_campbell_2009_bm3_mgd",
      "label": "Campbell et al. (2009), B1 FeO, 295 K BM3-Debye",
      "check": {
        "reproduction": "disagrees",
        "compared": "published_fit",
        "why": "q: refit 0.75 vs published 1.3 (-42.2%), beyond the agreement limit.",
        "warning": null,
        "source_check": "deferred",
        "source_checked_on": "2026-09-20",
        "source_note": "Four source-owned experimental thermal fits; adopted hcp-Fe and numerical buffer integrations are excluded as new EOS. Source explicitly treats FeO as stoichiometric B1; the exact 295 K variable-exponent thermal law is represented.",
        "audit": "../audits/feo.audit.json#feo_campbell_2009_bm3_mgd"
      },
      "model": "BM3",
      "temperature_ref": 295.0,
      "parameters": {
        "V0": {"value": 81.40626722913066, "error": null, "fixed": true},
        "K0": {"value": 146.9, "error": 1.3},
        "K0_prime": {"value": 4.0, "error": null, "fixed": true}
      },
      "thermal": {
        "model": "MieGruneisenDebye",
        "parameters": {
          "Tr": {"value": 295.0, "error": null, "fixed": true},
          "theta0": {"value": 380.0, "error": null, "fixed": true},
          "gamma0": {"value": 1.42, "error": 0.04},
          "q": {"value": 1.3, "error": 0.3},
          "n": {"value": 2.0, "error": null, "fixed": true}
        },
        "debye_temperature_law": "variable_exponent"
      },
      "parameter_error_confidence": null,
      "experimental_pressure_range_gpa": [3.9954833425198, 93.0],
      "experimental_temperature_range_k": [873.0, 2590.0],
      "range_provenance": {
        "source_location": "Tables S2-S3; Seagle (2008) Table 1 and subsolidus supplement for Fe/FeO",
        "notes": "Marginal experimental coverage, not a rectangular phase-stability field. Fe/FeO upper bounds include earlier Seagle approximate isobars; new-study-only bounds and selected-row extrema are in the reproduction JSON. fcc Fe and stoichiometric B1 FeO must remain within their source phase/composition fields. The 295 K reference is an extrapolation. NiO is a source cubic-average B1 model across unresolved magnetic distortion."
      },
      "determination_method": "experimental",
      "notes": "Equation (5) and Table 1: 295 K BM3 plus Mie-Gruneisen-Debye, gamma=gamma0*(V/V0)^q and theta=theta0*(V/V0)^(-gamma(V)). No explicit electronic or anharmonic pressure. Source molar V0 is converted to the Z=4 conventional cell using exact SI Avogadro constant. Italicized Table 1 values are held fixed, and nonitalic values with errors are fitted. The confidence convention and covariance of published errors are not specified. Temperature-corrected workbook values are used as printed; no second correction is applied. The published fit also includes Seagle et al. (2008). Its 81 V-T rows are linked, but exact row-wise pressures and Campbell recalibration are not published. Independent refits therefore report a current-study subset and a nominal-isobar sensitivity reconstruction. The starting Fe1-xO powder equilibrates with metallic Fe; Sections 2.1, 3 and 5 explicitly identify the selected oxide as stoichiometric Fe1.00O in B1, not Fe0.94O, rhombohedral wustite or B8. Stoichiometry follows the Stolen-Grønvold model-B field (above 5 GPa at 900 K, boundary slope below -120 K/GPa), not a direct per-row chemical assay. ",
      "fit_datasets": ["feo_campbell_2009_table_s2_pvt", "feo_seagle_2008_supplement_volume_temperature"],
      "reference": {
        "authors": ["Campbell", "Danielson", "Righter", "Seagle", "Wang", "Prakapenka"],
        "year": 2009,
        "title": "High pressure effects on the iron–iron oxide and nickel–nickel oxide oxygen fugacity buffers",
        "source": "Earth and Planetary Science Letters",
        "volume": "286",
        "locator": "556-564",
        "doi": "10.1016/j.epsl.2009.07.022"
      }
    }
