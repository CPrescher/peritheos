   "label": "Reynard et al. (1996), BM3, ruby pressure scale",
   "reference": {
    "authors": [
     "Reynard",
     "Fiquet",
     "Itié",
     "Rubie"
    ],
    "year": 1996,
    "source": "American Mineralogist",
    "volume": "81",
    "locator": "45-50",
    "doi": "10.2138/am-1996-1-206"
   },
   "record_kind": "published",
   "eos": {
    "type": "BM3",
    "parameters": {
     "V0": 262.3,
     "K0": 212.0,
     "K0_prime": 7.5
    },
    "model": "birch_murnaghan_3"
   },
   "parameter_errors": {
