    "K0"
   ],
   "experimental_pressure_range_gpa": [
    0.0,
    27.8
   ],
   "pressure_range_status": "reported_exactly",
   "experimental_temperature_range_k": [
    298.0,
    298.0
   ],
   "temperature_ref": 298.0,
   "identifier": "akimotoite_reynard_1996_bm3_ruby_2",
   "fit_datasets": [
    "akimotoite_reynard_1996_table1_compression"
   ],
   "parameter_provenance": {
    "equation": "Page 47 states that volumes were fitted to third-order Eulerian finite-strain equations of state; this maps to the standard third-order Birch-Murnaghan pressure-volume form.",
    "V0": "Figure 3e, page 48: fitted V0=262.3(4) A^3.",
    "K0": "Page 49 and Figure 3e: K0=212 GPa fixed to the Brillouin-scattering determination of Weidner and Ito (1985).",
    "K0_prime": "Abstract, Figure 3e, and page 49: K0'=7.5(10) using ruby-fluorescence pressures.",
    "volume_basis": "Table 1 conventional hexagonal unit-cell volume V=(sqrt(3)/2)*a^2*c; the MgSiO3 ilmenite cell has Z=6.",
    "temperature_ref": "The experiment and EOS are reported at ambient temperature; 298 K is the operational ambient-temperature reference used by this record."
   },
   "notes": "This is the ruby-pressure assignment of the same 16-row compression/decompression experiment represented by the companion ice-VII-scale record. It is a distinct fit, not a duplicate parameter transcription. The paper reports that V0 was varied and stayed within 0.01% of the measured in-cell value, while K0 was fixed at the adopted 212 GPa Brillouin value. Ruby-line broadening above 15 GPa showed increasing nonhydrostatic stress; the authors therefore regarded K0'=7.5 as less realistic than the ice-VII-scale result. The source gives neither parameter covariance nor a confidence convention for parenthesized fit errors, and it does not specify an exact ruby calibration equation. The numerical 298 K reference encodes the source's qualitative 'ambient temperature' wording rather than a measured sample temperature.",
   "pressure_calibration": {
    "status": "partially_resolved",
    "methods": [
     {
      "kind": "ruby_fluorescence",
      "source_location": "Pressure measurements and pressure-gradient estimation, pages 46-47; Table 1 column Pr",
      "notes": "Ruby fluorescence was measured before and after each 30-45 minute X-ray collection. The article does not cite or define the wavelength-to-pressure equation."
     }
    ],
    "recalculation": {
     "status": "not_possible",
     "notes": "Table 1 supplies reduced ruby pressures and line-width-derived uncertainty estimates but no R1 wavelengths or exact ruby calibration equation. The published reported-pressure fit can be refitted, but the pressure reduction cannot be recalculated."
    },
    "audit_date": "2026-09-04",
    "notes": "Ruby fluorescence is explicit, but the exact ruby scale is unresolved and is not inferred from publication year."
   },
   "scientific_validation": {
    "status": "primary_source_validated",
    "note": "Checked directly against the final American Mineralogist article; LitCurate was used only as a discovery lead.",
