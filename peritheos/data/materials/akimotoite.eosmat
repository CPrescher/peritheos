    {
      "identifier": "akimotoite_reynard_1996_bm3_ruby_2",
      "label": "Reynard et al. (1996), BM3, ruby pressure scale",
      "model": "BM3",
      "temperature_ref": 298.0,
      "parameters": {
        "V0": {"value": 262.3, "error": 0.4},
        "K0": {"value": 212.0, "error": null, "fixed": true},
        "K0_prime": {"value": 7.5, "error": 1.0}
      },
      "parameter_error_confidence": null,
      "experimental_pressure_range_gpa": [0.0, 27.8],
      "experimental_temperature_range_k": [298.0, 298.0],
      "pressure_range_status": "reported_exactly",
      "determination_method": "experimental",
      "record_kind": "published",
      "notes": "This is the ruby-pressure assignment of the same 16-row compression/decompression experiment represented by the companion ice-VII-scale record. It is a distinct fit, not a duplicate parameter transcription. The paper reports that V0 was varied and stayed within 0.01% of the measured in-cell value, while K0 was fixed at the adopted 212 GPa Brillouin value. Ruby-line broadening above 15 GPa showed increasing nonhydrostatic stress; the authors therefore regarded K0'=7.5 as less realistic than the ice-VII-scale result. The source gives neither parameter covariance nor a confidence convention for parenthesized fit errors, and it does not specify an exact ruby calibration equation. The numerical 298 K reference encodes the source's qualitative 'ambient temperature' wording rather than a measured sample temperature.",
      "fit_datasets": ["akimotoite_reynard_1996_table1_compression"],
      "reference": {
        "authors": ["Reynard", "Fiquet", "Itié", "Rubie"],
        "year": 1996,
        "title": "High-pressure X-ray diffraction study and equation of state of MgSiO3 ilmenite",
        "source": "American Mineralogist",
        "volume": "81",
        "locator": "45-50",
        "doi": "10.2138/am-1996-1-206"
      },
      "check": {
        "reproduction": "reproduced",
        "warning": null,
        "finding": "The standard BM3 fit uses conventional hexagonal-cell volumes (Z=6), holds K0 at 212 GPa, varies V0, and gives V0=262.3(4) A^3 and K0'=7.5(10) on the ruby-pressure assignment. At V=239.13 A^3 the stored curve gives 27.53 GPa, consistent with the Table 1 ruby value 27.8[5] GPa.",
        "source": "primary_source_validated",
        "source_checked_on": "2026-09-04",
        "audit": "../audits/akimotoite.audit.json#akimotoite_reynard_1996_bm3_ruby_2"
      }
    },
    {
      "identifier": "akimotoite_reynard_1996_bm3_ice_vii_3",
