      "thermal": {
        "model": "MieGruneisenDebye",
        "parameters": {
          "Tr": {"value": 300.0, "error": null, "fixed": true},
          "theta0": {"value": 740.0, "error": 5.0, "fixed": true},
          "gamma0": {"value": 0.91, "error": 0.07, "fixed": true},
          "q": {"value": 1.0, "error": null, "fixed": true},
