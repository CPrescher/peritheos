        "volume": "103",
        "locator": "20813-20818",
        "doi": "10.1029/98JB01575"
      },
      "equation_kind": "isothermal",
      "sample_composition": "99% pure polycrystalline MgAl2O4 spinel starting material mixed with 5 wt% Pt; run-2 transformation product assigned to CaFe2O4-type MgAl2O4",
      "experimental_configuration": {
        "apparatus": "laser-heated Mao-Bell diamond-anvil cell",
        "laser_heating": "2000-3000 K for about 60 minutes",
        "measurement_temperature": "room temperature after heating; no numerical value reported",
        "diffraction": "synchrotron X-ray diffraction at SSRL beamline 10-2",
        "pressure_medium": "No pressure-transmitting medium is reported; the sample was mixed with 5 wt% Pt.",
        "pressure_gauges": "Mao et al. (1978) ruby fluorescence and Holmes et al. (1989) Pt EOS; the reported 33.4 GPa state is their post-heating average"
      }
    },
