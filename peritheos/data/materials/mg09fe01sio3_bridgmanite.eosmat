      "record_kind": "published",
      "notes": "Published 300 K post-transition branch with low-spin B-site Fe3+. Stored as BM3 because the source calls the fit third-order Birch-Murnaghan; with K0' = 4 fixed it reduces to the second-order form.",
      "fit_datasets": ["mg09fe01sio3_bridgmanite_mao_2015_table_s1_pv"],
      "reference": {
        "authors": ["Mao", "Lin", "Yang", "Inoue", "Prakapenka"],
