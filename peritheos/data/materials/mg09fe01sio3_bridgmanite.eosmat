      "equation_kind": "isothermal",
      "sample_composition": "(Mg0.9Fe0.1)SiO3 (Pv10), Al-free polycrystalline bridgmanite with a small stishovite impurity",
      "experimental_configuration": {
        "sample": "Same presynthesized Pv10 batch characterized by electron microscopy, XRD, conventional Mossbauer spectroscopy, and synchrotron Mossbauer spectroscopy; approximately 10% stishovite impurity is reported by Lin et al. (2012).",
        "pressure_medium": "neon",
        "pressure_cell": "symmetric diamond-anvil cells with rhenium gaskets",
        "pressure_gauge": "platinum powder using Fei et al. (2007)",
        "diffraction": "angle-dispersive synchrotron X-ray diffraction at GSECARS, Advanced Photon Source, with a 5 x 7 micrometre beam",
        "runs": "Three room-temperature runs from near ambient pressure to 120.1-125.6 GPa; from approximately 30 GPa the sample and Pt were laser annealed near 1500 K at selected 8-15 GPa steps before room-temperature diffraction."
      },
      "iron_speciation": "Approximately 20% of total Fe is Fe3+ assigned to the octahedral B site and approximately 80% is Fe2+ assigned to the pseudododecahedral A site; this EOS is the pressure-above-25-GPa branch where the B-site Fe3+ is low spin. The A-site Fe2+ remains high spin in the same-batch spectroscopy to 120 GPa."
    },
