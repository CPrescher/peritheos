      "identifier": "argon_fcc_dewaele_2021_vinet_mgd",
      "label": "Dewaele et al. (2021), quasi-hydrostatic Vinet-MGD",
      "check": {
        "reproduction": "close",
        "compared": "published_fit",
        "why": "All coefficients are within the agreement limit; no published or refit error for V0 and K0', so they could not be tested against twice the combined error.",
        "warning": null,
        "source_check": "verified",
        "source_checked_on": "2026-09-24",
        "audit": "../audits/argon_fcc.audit.json#argon_fcc_dewaele_2021_vinet_mgd"
      },
      "model": "Vinet",
      "temperature_ref": 296.0,
      "parameters": {
        "V0": 152.0,
        "K0": {"value": 2.65, "fixed": true},
        "K0_prime": 7.423
      },
      "thermal": {
        "model": "Dewaele2006",
        "parameters": {
          "Tr": {"value": 296.0, "fixed": true},
          "theta0": {"value": 93.3, "fixed": true},
          "gamma0": {"value": 2.7, "fixed": true},
          "gamma_inf": {"value": 0.5, "fixed": true},
          "beta": {"value": 1.0, "fixed": true},
          "anharmonic_a": {"value": 0.0, "fixed": true},
          "anharmonic_m": {"value": 1.0, "fixed": true},
          "electronic_e": {"value": 0.0, "fixed": true},
          "electronic_g": {"value": 1.0, "fixed": true},
          "n": {"value": 1.0, "fixed": true}
        },
        "thermal_pressure_reference": "absolute_zero"
      },
      "experimental_pressure_range_gpa": [1.3463738, 64.599632],
      "experimental_temperature_range_k": [10.0, 296.0],
      "determination_method": "hybrid",
      "notes": "0 K Vinet cold curve plus absolute Debye thermal pressure that excludes zero-point pressure; Tr = 296 K anchors thermal-pressure increments only. Fitted to quasi-hydrostatic runs 2-3 plus pure argon below 5 GPa; pure-Ar compression to 114 GPa is a separate comparison. Low-temperature validation is below about 20 GPa, not the full P-T range.",
      "fit_datasets": ["argon_fcc_dewaele_2021_supplement"],
      "reference": {
        "authors": ["Dewaele", "Rosa", "Guignot", "Andrault", "Rodrigues", "Garbarino"],
        "year": 2021,
        "title": "Stability and equation of state of face-centered cubic and hexagonal close packed phases of argon under pressure",
        "source": "Scientific Reports",
        "volume": "11",
        "locator": "15192",
        "doi": "10.1038/s41598-021-93995-y"
      }
