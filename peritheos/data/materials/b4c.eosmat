    "doi": "10.1098/rsta.2022.0331"
   },
   "eos": {
    "type": "BM3",
    "parameters": {
     "V0": 328.4,
     "K0": 221.0,
     "K0_prime": 3.3
    },
    "model": "birch_murnaghan_3"
   },
   "parameter_errors": {
