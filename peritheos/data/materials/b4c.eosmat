    ],
    "primary_source_check": {
     "access_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10460643/",
     "locations": [
      "Abstract",
      "Figure 1 caption",
      "Equations 3.1-3.7",
      "Figure 4 caption",
      "Table 1",
      "official supplementary material, equations 1-9 and Tables 3-4"
     ],
     "finding": "The article and supplement define an integrated constant-q MGD model that Peritheos represents exactly. The article's final gamma0=0.8, q=2.1 parameterization gives a 1.39 GPa pressure RMSE on the 41 heated supplementary points. A Peritheos P-V-T errors-in-variables refit with gamma0 fixed gives q=1.050(519), rather than independently recovering q=2.1. Source contradictions in EOS order, theta0, gamma0/q, and nominal reference temperature are retained explicitly with evidence-based resolutions.",
     "doi": "10.1098/rsta.2022.0331"
    },
    "migration_source": {
     "project": "Dioptas",
     "version": "0.10.0",
     "commit": "5a8bfd81d10bfab3499039603380aae34576d60a",
     "file": "b4c.json"
    },
    "reported_inconsistencies": [
     {
      "field": "eos.order",
      "abstract": "third-order Birch-Murnaghan",
      "figure_1_caption": "second-order Birch-Murnaghan",
      "resolution": "Retain BM3 because K0'=3.3(1), which is incompatible with a conventional BM2 fit where K0'=4 is fixed."
     },
     {
      "field": "thermal.parameters.theta0",
      "figure_4_caption": "1425 K (fixed)",
      "main_table_1": "1450 K (fixed)",
      "supplement": "1425 K (fixed, repeated in the fit description and Figure 1 caption)",
      "resolution": "Use 1425 K because it is repeated in the main figure caption and official supplement; treat the single 1450 K table entry as a typographical inconsistency."
     },
     {
      "field": "thermal.parameters.gamma0_and_q",
      "main_article": "gamma0=0.8 fixed; q=2.1 varied",
      "supplement_figure_1": "gamma0=0.95(5), q=2.1 described as best; gamma0=0.8 is plotted with q=2.8",
      "resolution": "Use the final peer-reviewed article pair gamma0=0.8 and q=2.1. At the official heated data's printed V and T, this pair gives a pressure RMSE of 1.39 GPa and chi-squared per observation of 0.961. A full Peritheos P-V-T errors-in-variables refit with gamma0 fixed gives q=1.050(519), so the refit is documented as a diagnostic rather than promoted over the published pair."
     },
