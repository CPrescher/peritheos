      },
      "source_location": "Experimental pressure determination and EOS analysis",
      "reference_eos_record": "mgo_b1_tange_2009_vinet"
     }
    ],
    "recalculation": {
     "status": "missing_calibrant_observations",
     "notes": "The exact reference EOS is executable in the bundled library, but recalculation also requires the row-wise calibrant volume and temperature observations."
    },
    "audit_date": "2026-09-03"
   },
   "scientific_validation": {
    "status": "primary_source_validated",
    "note": "Independently checked against the cited primary publication (published article or official/author copy); no external software catalog was used as scientific authority.",
    "audit_date": "2026-09-03",
    "verified_fields": [
     "equation",
