    2500.0
   ],
   "thermal": {
    "type": "AlphaKT",
    "model": "thermal_reference_state",
    "thermal_expansion_law": "linear_temperature",
    "reference_volume_law": "berman",
    "parameters": {
     "Tr": 298.0,
     "alpha0": 1.94e-05,
     "alpha1": 5.73e-10,
     "dK_dT": -0.008
    },
    "parameter_errors": {
     "Tr": null,
     "alpha0": 1.6e-06,
     "alpha1": null,
     "dK_dT": 0.003
    },
    "fixed_parameters": [
     "Tr",
     "alpha1"
    ]
   },
   "fit_datasets": [
    "b4c_somayazulu_2023_table4_pvt"
   ],
   "notes": "The paper calls this the Berman P-V-T fit. EosFit7 implements the Berman reference volume as the truncated quadratic V0(T)=V0*[1+alpha0*(T-Tr)+0.5*alpha1*(T-Tr)^2], with K0(T)=K0+dK0/dT*(T-Tr). EosFit7c varied alpha0=1.94(16)e-5 K^-1 and dK0/dT=-0.008(3) GPa/K while alpha1=0.0573e-8 K^-2 and the 300 K BM3 parameters were fixed. The article's displayed exponential-integral equation instead describes EosFit's Fei-style exact integration and is inconsistent with its Berman label. The implied BM3 K0''=-0.0166 GPa^-1 is derived rather than an independent parameter. Reproduction diagnostics compare both EosFit effective-variance and Peritheos errors-in-variables objectives.",
   "identifier": "b4c_somayazulu_2023_berman_2",
   "pressure_calibration": {
    "status": "resolved",
    "methods": [
     {
