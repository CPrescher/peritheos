    {
      "identifier": "grossular_angel_2022_bm3_q_compromise_debye",
      "label": "Angel et al. (2022), BM3 + q-compromise Debye",
      "check": {
        "reproduction": "untested",
        "compared": "none",
        "warning": null,
        "source_check": "verified",
        "source_checked_on": "2026-11-08",
        "source_note": "Coefficients from official supplementary EOS file 1, which carries the full 59x59 covariance; the printed molar V0 = 125.35 cm³/mol is converted to the eight-formula-unit cell.",
        "audit": "../audits/grossular.audit.json#grossular_angel_2022_bm3_q_compromise_debye"
      },
      "model": "BM3",
      "temperature_ref": 298.0,
      "parameters": {
        "V0": {"value": 1665.1885765619334, "error": null, "fixed": true},
        "K0": {"value": 167.002, "error": 0.2},
        "K0_prime": {"value": 5.06534, "error": 0.08}
      },
      "thermal": {
        "model": "QCompromiseDebye",
        "parameters": {
          "Tr": {"value": 298.0, "fixed": true},
          "theta0": {"value": 749.825, "error": 13.0},
          "gamma0": {"value": 1.15602, "error": 0.006},
          "n": {"value": 20.0, "fixed": true}
        }
      },
      "parameter_error_confidence": null,
      "parameter_covariance": {
        "parameter_order": ["rt_eos.K0", "rt_eos.K0_prime", "theta0", "gamma0"],
        "matrix": [
          [0.038718, 0.0022213, -0.16156, 0.0001981],
          [0.0022213, 0.0054026, -0.027319, -4.0539e-05],
          [-0.16156, -0.027319, 166.37, 0.055808],
          [0.0001981, -4.0539e-05, 0.055808, 2.598e-05]
        ]
      },
      "experimental_pressure_range_gpa": [0.0, 16.9],
      "experimental_temperature_range_k": [20.0, 1650.0],
      "range_provenance": {
        "source_location": "Supplementary Table S1, nonzero-used rows",
        "notes": "Union of volume and elastic-modulus constraints, including room-pressure low-T expansion and high-P room-T compression. Independent experimental series; not a rectangular phase-stability field. Rejected high-T PVT rows do not extend coverage."
      },
      "determination_method": "experimental",
      "notes": "Published q-compromise approximation: theta0 and gamma/V are constant and there is no q parameter. V0 is adopted and fixed from Holland and Powell (2011), not refitted or measured; the other coefficients carry more digits than Table 1, as in the source files. The model gives P-V-T and pressure derivatives, not a caloric potential or mixing model.",
      "reference": {
        "authors": ["Angel", "Gilio", "Mazzucchelli", "Alvaro"],
        "year": 2022,
        "title": "Garnet EoS: a critical review and synthesis",
        "source": "Contributions to Mineralogy and Petrology",
        "volume": "177",
        "locator": "54",
        "doi": "10.1007/s00410-022-01918-5"
      }
    }
  ],
  "family_id": "garnet",
