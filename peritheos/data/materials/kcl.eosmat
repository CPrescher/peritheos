   "resource": {
    "path": "datasets/kcl-campbell-1991-table1-compression.csv",
    "sha256": "91671aa26aa19fb20450bf708f260a0e6040c56af1e37d7834f7bbec42a0830f",
    "media_type": "text/csv"
   },
   "notes": "Table 1 normalizes volumes to the B1-KCl molar volume V01=37.521 cm^3/mol; the methods adopt B1 a0=6.2931 A (JCPDS). Pressures use Mao et al. (1978) ruby fluorescence (reference 5). Each pressure is the mean of five spatial readings; its uncertainty is their standard deviation, not the standard error of the mean. Volume uncertainties are standard deviations across diffraction-line volumes. No pressure medium was used. The five individual ruby readings, raw spectra, and coordinate covariance are not published. Parenthesized EOS parameter errors have no stated confidence convention.",
   "reference": {
    "authors": [
     "Campbell",
     "Heinz"
    ],
    "year": 1991,
    "source": "J. Phys. Chem. Solids",
    "volume": "52",
