          "alpha_KT": {"value": 0.00224, "error": null}
        }
      },
      "experimental_pressure_range_gpa": [2.6, 165.0],
      "experimental_temperature_range_k": [298.0, 298.0],
      "validity": {
        "pressure_gpa": [2.6, 200.0],
        "temperature_k": [300.0, 7000.0],
        "volume_ratio": [0.4, 1.0],
        "notes": [
          "The 298 K experimental compression data extend from the B1-B2 transition at 2.6 GPa to 165 GPa.",
          "Equation (2) and Table V extend the calibration to 200 GPa and 7000 K using molecular-dynamics thermal pressures over V/V0=0.4-1.0; states above 165 GPa or 298 K are not direct static-compression measurements."
        ]
      },
      "determination_method": "hybrid",
      "default": true,
      "notes": "Preferred broadly useful B2-KCl pressure calibration. The reference isotherm is the Rydberg-Vinet fit to helium-medium 298 K measurements; the paper writes it as a 300 K term in Equation (2). V0 is a fictive zero-pressure B2 value fixed from the 2-6 GPa observations. The additive alpha*K_T term comes from ab initio molecular dynamics. The paper tabulates neither individual coefficient errors nor covariance, so they remain unavailable rather than being set to zero.",
      "reference": {
        "authors": ["Dewaele", "Belonoshko", "Garbarino", "Occelli", "Bouvier", "Hanfland", "Mezouar"],
        "year": 2012,
        "title": "High-pressure–high-temperature equation of state of KCl and KBr",
        "source": "Phys. Rev. B",
        "volume": "85",
        "locator": "214105",
        "doi": "10.1103/PhysRevB.85.214105"
      },
      "check": {
        "reproduction": "close",
        "warning": null,
        "finding": "The paper provides the complete B2-KCl P-V-T equation and parameters, explicitly recommends it for pressure calibration, and prints no fitted-parameter errors or covariance.",
        "source": "primary_source_validated",
        "source_checked_on": "2026-09-01",
        "audit": "../audits/kcl.audit.json#kcl_b2_dewaele_2012_vinet_3"
      }
    },
    {
      "identifier": "kcl_b2_tateno_2019_vinet_4",
      "label": "Tateno et al. (2019), B2 Vinet + MGD on Sokolova Pt",
      "model": "Vinet",
      "temperature_ref": 300.0,
      "parameters": {
        "V0": {"value": 54.5, "error": null, "fixed": true},
        "K0": {"value": 18.3, "error": 0.3},
        "K0_prime": {"value": 5.6, "error": 0.03}
      },
      "thermal": {
        "model": "MieGruneisenDebye",
        "parameters": {
          "Tr": {"value": 300.0, "error": null, "fixed": true},
          "theta0": {"value": 235.0, "error": null, "fixed": true},
          "gamma0": {"value": 2.3, "error": 0.2},
          "q": {"value": 0.8, "error": 0.2},
          "n": {"value": 2, "error": null, "fixed": true}
        },
        "debye_temperature_law": "integrated_gruneisen"
      },
      "experimental_pressure_range_gpa": [4.2, 228.6],
      "experimental_temperature_range_k": [300.0, 2560.0],
      "validity": {
        "pressure_gpa": [4.2, 228.6],
        "temperature_k": [300.0, 2560.0],
        "volume_ratio": [0.36, 1.0],
        "notes": [
          "Room-temperature compression reaches 228.6 GPa; the heated observations reach 60.7 GPa and 2560 K.",
          "The B2 phase has a fictive zero-pressure reference state."
        ]
      },
      "determination_method": "experimental",
      "notes": "Preferred final-publication Tateno fit on the Sokolova Pt scale. The final article reports gamma0=2.3+/-0.2 and q=0.8+/-0.2 and defines theta(V)=theta0*exp[(gamma0-gamma(V))/q], the integrated-Gruneisen Debye law. The accepted manuscript instead printed gamma0=0.58+/-0.05 and q=0.9+/-0.2; those superseded values are not used. Table 1 also gives a Holmes-Pt alternative, which is not represented by this record. All 39 observations come from the official MSA Supplemental Table S1 workbook.",
      "reference": {
        "authors": ["Tateno", "Komabayashi", "Hirose", "Hirao", "Ohishi"],
        "year": 2019,
        "title": "Static compression of B2 KCl to 230 GPa and its P-V-T equation of state",
        "source": "American Mineralogist",
        "volume": "104",
        "locator": "718-723",
        "doi": "10.2138/am-2019-6779"
      },
      "check": {
        "reproduction": "reproduced",
        "warning": null,
        "finding": "The final article's preferred Sokolova-Pt fit fixes V0=54.5 A^3 and theta0=235 K and reports K0=18.3(3) GPa, K0'=5.60(3), gamma0=2.3(2), and q=0.8(2). Equation 6 is the integrated-Gruneisen Debye-temperature law. The accepted manuscript's gamma0=0.58(5) and q=0.9(2) are superseded.",
        "source": "primary_source_validated",
        "source_checked_on": "2026-09-04",
        "audit": "../audits/kcl.audit.json#kcl_b2_tateno_2019_vinet_4"
      }
    },
    {
