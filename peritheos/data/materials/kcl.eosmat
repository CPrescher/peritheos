      },
      "thermal": {
        "model": "LinearThermalPressure",
        "parameters": {
          "Tr": {"value": 296.15, "error": null, "fixed": true},
          "alpha_KT": {"value": 0.00275, "error": 9e-05}
        }
      },
      "experimental_pressure_range_gpa": [3.18, 8.14],
      "experimental_temperature_range_k": [296.15, 873.15],
      "determination_method": "experimental",
      "notes": "Preferred staged B2 result of Table 3 (bold row): K0 and K0' are fitted to the room-temperature data with the fictive V0 fixed, then Equation BE1 fits alpha0*K0 to the P-V-T data. The paper considers individual parameter errors meaningless because of correlation and gives an error only for alpha0*K0. The simultaneous four-parameter solution (italic row) is not this record.",
      "reference": {
        "authors": ["Walker", "Cranswick", "Verma", "Clark", "Buhre"],
        "year": 2002,
        "title": "Thermal equations of state for B1 and B2 KCl",
        "source": "American Mineralogist",
        "volume": "87",
        "locator": "805-812",
        "doi": "10.2138/am-2002-0701"
      }
