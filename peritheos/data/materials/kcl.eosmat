     "reference": {
      "authors": [
       "Campbell",
       "Heinz"
      ],
      "year": 1991,
      "title": "Compression of KCl in the B2 structure to 56 GPa",
      "source": "J. Phys. Chem. Solids",
      "volume": "52",
