    {
      "identifier": "kcl_b2_dewaele_2012_vinet_3",
      "label": "Dewaele et al. (2012), B2 P-V-T pressure calibration",
      "check": {
        "reproduction": "close",
        "compared": "published_fit",
        "why": "All coefficients are within the agreement limit; the paper gives no error for K0 and K0', so they could not be tested against twice the combined error.",
        "warning": null,
        "source_check": "verified",
        "source_checked_on": "2026-09-01",
        "source_note": "Reference isotherm from the experimental B2 Vinet fit of Table III and Table V; alpha_KT from the molecular-dynamics thermal-pressure fit of Equation (2) and Table V. The paper recommends this equation for pressure calibration.",
        "audit": "../audits/kcl.audit.json#kcl_b2_dewaele_2012_vinet_3"
      },
      "model": "Vinet",
      "temperature_ref": 300.0,
      "parameters": {
        "V0": {"value": 54.5, "error": null, "fixed": true},
        "K0": {"value": 17.2, "error": null},
        "K0_prime": {"value": 5.89, "error": null}
      },
      "thermal": {
        "model": "LinearThermalPressure",
        "parameters": {
          "Tr": {"value": 300.0, "error": null, "fixed": true},
          "alpha_KT": {"value": 0.00224, "error": null}
        }
      },
      "validity": {
        "pressure_gpa": [2.6, 200.0],
        "temperature_k": [300.0, 7000.0],
        "volume_ratio": [0.4, 1.0],
        "notes": [
          "The 298 K experimental compression data extend from the B1-B2 transition at 2.6 GPa to 165 GPa.",
          "Above 165 GPa or 298 K the range rests on molecular-dynamics thermal pressures (Equation (2), Table V), not static-compression data."
        ]
      },
      "experimental_pressure_range_gpa": [2.6, 165.0],
      "experimental_temperature_range_k": [298.0, 298.0],
      "determination_method": "hybrid",
      "notes": "Vinet fit to helium-medium 298 K data, written as a 300 K term in Equation (2), plus an additive alpha*K_T thermal term from ab initio molecular dynamics. V0 is a fictive zero-pressure B2 value fixed from the 2-6 GPa observations.",
      "reference": {
        "authors": ["Dewaele", "Belonoshko", "Garbarino", "Occelli", "Bouvier", "Hanfland", "Mezouar"],
        "year": 2012,
        "title": "High-pressure–high-temperature equation of state of KCl and KBr",
        "source": "Phys. Rev. B",
        "volume": "85",
        "locator": "214105",
        "doi": "10.1103/PhysRevB.85.214105"
      }
