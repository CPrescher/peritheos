      "identifier": "kcl_campbell_1991_bm2_1",
      "label": "Campbell and Heinz (1991) + Dewaele et al. (2012), B2 BM2",
      "check": {
        "reproduction": "reproduced",
        "compared": "published_fit",
        "warning": null,
        "source_check": "verified",
        "source_checked_on": "2026-10-08",
        "source_note": "The V0 ratio and K0 are from the Campbell and Heinz abstract (BM2, K0' = 4); the B1 V0 is from Dewaele et al. (2012) Table III. Pressures use the Mao et al. (1978) ruby calibration with a five-position mean.",
        "audit": "../audits/kcl.audit.json#kcl_campbell_1991_bm2_1"
      },
      "model": "BM2",
      "temperature_ref": 298.0,
      "parameters": {
        "V0": {"value": 52.899988, "error": 0.355452, "fixed": true},
        "K0": {"value": 28.7, "error": 0.6}
      },
      "experimental_pressure_range_gpa": [2.0, 56.0],
      "determination_method": "experimental",
      "notes": "Composite B2 isotherm: Campbell and Heinz report V0(B2)/V0(B1) = 0.8483 ± 0.0057, and V0 = 0.8483 × 62.36 Å³ per formula unit uses the experimental B1 V0 of Dewaele et al. (2012). The V0 error propagates only the ratio error, since Dewaele et al. give no B1 V0 error.",
      "reference": {
        "authors": ["Campbell", "Heinz"],
        "year": 1991,
        "title": "Compression of KCl in the B2 structure to 56 GPa",
        "source": "J. Phys. Chem. Solids",
        "volume": "52",
        "locator": "495-499",
        "doi": "10.1016/0022-3697(91)90181-X"
      }
    },
    {
