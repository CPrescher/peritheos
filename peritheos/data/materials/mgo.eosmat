    ],
    "year": 2006,
    "title": "Elasticity of MgO to 11 GPa with an independent absolute pressure scale: Implications for pressure calibration",
    "source": "J. Geophys. Res. Solid Earth",
    "volume": "111",
    "locator": "B11206",
    "doi": "10.1029/2005JB004251"
   },
   "record_kind": "published",
   "eos": {
