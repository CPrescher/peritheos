        "Li",
        "Wu",
        "Liu",
        "Li",
        "Xian",
        "Wu"
       ],
       "year": 2023,
       "source": "Phys. Rev. B",
       "doi": "10.1103/PhysRevB.107.134116"
      },
      "source_location": "Equations (7)-(10), Table I, and Section II.B.2",
      "scope": "Hugoniot P-V-T and sound-velocity constraints",
      "notes": "Pressure follows the Rankine-Hugoniot relations from measured shock and particle velocities. Shots 2, 3, and 5 obtain particle velocity by impedance matching to the printed Ta or Pt flyer Hugoniots; Shots 1 and 4 use Doppler-pin measurements."
     },
     {
      "kind": "ultrasonic",
      "reference": {
       "authors": [
        "Kono",
        "Irifune",
        "Higo",
        "Inoue",
        "Barnhoorn"
       ],
       "year": 2010,
       "source": "Phys. Earth Planet. Inter.",
       "volume": "183",
       "locator": "196",
       "doi": "10.1016/j.pepi.2010.03.010"
      },
      "source_location": "Section II.B.2 and Appendix A",
      "scope": "Room-temperature pressure-scale-independent sound-velocity constraints"
     }
    ],
    "recalculation": {
     "status": "not_possible",
     "notes": "The five new Table I shock states are bundled and their reduced pressures can be checked, but the complete global fit also selects observations from multiple earlier publications and requires unpublished sound-velocity-density fit coefficients and the detailed objective implementation."
