    "reported_inconsistencies": [
     {
      "field": "preferred decompression K0S",
      "abstract_and_section_4": "163.5(11) GPa",
      "table_2": "163.6(11) GPa",
      "resolution": "The stored isothermal derivation uses 163.5 GPa because the abstract and narrative results agree on that value; the conflicting Table 2 value is retained here rather than silently averaged."
     },
     {
      "field": "fourth initial-compression Table 1 volume ratio",
      "table_1": "V/V0=0.962, density=3.696(6) g/cm^3, Pcal=6.23(14) GPa",
      "finding": "The printed ratio is not mutually consistent with the row density and the published BM3 pressure at the displayed precision. It is retained verbatim; no correction is inferred."
     }
    ],
    "numerical_reproduction": {
     "published_curve_check": "At the Table 1 endpoint V/V0=0.942, the stored BM3 predicts 10.9321 GPa versus the printed calculated pressure 10.95(15) GPa.",
     "reference_state_check": "The stored equation gives P(V0)=0 and K(V0)=K0T; inverse pressure-volume evaluation is tested across the reported branch.",
     "independent_acoustic_refit_check": "An unweighted simultaneous nonlinear least-squares fit of Equations 1-2 to the ten decompression density/VP/VS rows plus the independently reported ambient density/VP/VS anchor gives K0S=163.5115 GPa, K0S'=4.15807, G0=129.7175 GPa, and G0'=2.39724. All four recover the preferred published coefficients within their reported one-standard-deviation errors. Equation 4 then gives K0T=161.1881 GPa and K0T'=4.19657, differing from the stored source-derived values by 0.0113 GPa and 0.0413, respectively. The high-pressure-row RMS residuals are 0.02165 km/s for VP and 0.01474 km/s for VS, versus the paper's rounded 0.02 and 0.015 km/s.",
     "refit_status": "not_directly_refittable_as_pressure_volume",
     "limitation": "Table 1 pressure was calculated from the same acoustic-derived BM3 and is not an independent pressure coordinate. Regressing those Pcal-V/V0 pairs would be circular and would also be limited by ratios printed to only three decimals. The paper does not state an observation-weighting rule or fitting software; the deterministic audit fit therefore uses ordinary unweighted velocity residuals and is evidence of coefficient recovery within published uncertainty, not a claim to reproduce the authors' covariance calculation."
    },
