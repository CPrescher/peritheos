   "parameter_provenance": {
    "eos.V0": "Abstract and Table 2, preferred FPMD-LDA Vinet column; 46.17 A^3 per formula unit at 1000 K and zero pressure.",
    "eos.K0": "Abstract gives K_T0 at 1000 K as 203.95 GPa; this value independently reproduces the one-decimal Table 1 isochors. The PDF text extraction of Table 2 reads 203.5 GPa and is preserved as a source inconsistency.",
    "eos.K0_prime": "Table 2, preferred FPMD-LDA Vinet column; 4.76.",
    "thermal.Tr": "Section 4 and Table 2; 1000 K reference isotherm because the cubic phase is unstable at 300 K.",
    "thermal.theta0": "Table 2; 1100 K, fixed.",
    "thermal.gamma0": "Abstract and Table 2; 1.576.",
    "thermal.q": "Abstract and Table 2; 0.96.",
    "thermal.n": "Tange et al. (2009), equation 5, defines n as atoms per formula unit; CaSiO3 has five atoms."
