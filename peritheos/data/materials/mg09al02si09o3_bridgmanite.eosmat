  "topology_proxy_location": "MgSiO3 Pbnm fractional coordinates also used by the bundled bridgmanite material, COD 9005757",
  "publisher_article_url": "https://www.jstage.jst.go.jp/article/pjab1977/76/8/76_8_103/_article",
