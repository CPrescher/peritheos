      "parameters": {
        "A_gpa": 1904.0,
        "B": 5.0,
        "reference_wavelength_nm": 694.2
      },
      "equation": "P = (A/B) * ((lambda/lambda0)^B - 1)",
      "reference": {
        "authors": ["Mao", "Bell", "Shaner", "Steinberg"],
        "year": 1978,
        "title": "Specific volume measurements of Cu, Mo, Pd, and Ag and calibration of the ruby R1 fluorescence pressure gauge from 0.06 to 1 Mbar",
