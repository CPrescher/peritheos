    {
      "identifier": "ruby_holzapfel_2005",
      "label": "Holzapfel (2005) practical ruby scale",
      "kind": "ruby_fluorescence",
      "model": "holzapfel_freund_ingalls",
      "parameters": {
        "A_gpa": 1845.0,
        "B": 14.7,
        "C": 7.5,
        "reference_wavelength_nm": 694.24
      },
      "equation": "P = A/(B+C) * (exp((B+C)/C * (1 - (lambda0/lambda)^C)) - 1)",
      "reference": {
        "authors": ["Holzapfel"],
        "year": 2005,
        "title": "Progress in the realization of a practical pressure scale for the range 1-300 GPa",
        "source": "High Pressure Research",
        "doi": "10.1080/09511920500147501"
      },
      "validity": {
        "pressure_gpa": [0.0, 300.0],
        "temperature_k": [298.0, 298.0],
        "notes": "Best-fit Freund-Ingalls form using the 2005 coefficients A=1845 GPa, B=14.7, and C=7.5."
      }
    },
    {
      "identifier": "ruby_dorogokupets_oganov_2007",
      "label": "Dorogokupets and Oganov (2007) ruby scale",
      "kind": "ruby_fluorescence",
      "model": "quadratic_shift",
      "parameters": {
        "A_gpa": 1884.0,
        "m": 5.5,
        "reference_wavelength_nm": 694.24
      },
      "equation": "P = A * (delta_lambda/lambda0) * (1 + m * delta_lambda/lambda0)",
      "reference": {
        "authors": ["Dorogokupets", "Oganov"],
        "year": 2007,
        "title": "Ruby, metals, and MgO as alternative pressure scales: A semiempirical description of shock-wave, ultrasonic, x-ray, and thermochemical data at high temperatures and pressures",
        "source": "Phys. Rev. B",
        "doi": "10.1103/PhysRevB.75.024115"
      },
      "validity": {
        "pressure_gpa": [0.0, 300.0],
        "temperature_k": [298.0, 298.0],
        "notes": "The publication recommends this quadratic-shift form after comparing alternative forms."
      }
    }
