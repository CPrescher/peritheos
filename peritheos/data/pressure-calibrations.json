      "kind": "ruby_fluorescence",
      "model": "power_law",
      "parameters": {
        "A_gpa": 1904.0,
        "B": 9.5,
        "reference_wavelength_nm": 694.24
      },
      "equation": "P = (A/B) * ((lambda/lambda0)^B - 1)",
